<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArsStudio.ViewModels"
        xmlns:m="using:ArsStudio.Core"
        xmlns:views="using:ArsStudio.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="450"
        x:Class="ArsStudio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Images/icon.png"
        Title="ARS Studio"
        Width="1100" Height="720"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource InkBrush}"
        FontSize="12"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="D0" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Empty}" />
        <KeyBinding Gesture="D1" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.White}" />
        <KeyBinding Gesture="D2" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Yellow}" />
        <KeyBinding Gesture="D3" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Orange}" />
        <KeyBinding Gesture="D4" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Red}" />
        <KeyBinding Gesture="D5" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Green}" />
        <KeyBinding Gesture="D6" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Blue}" />
        <KeyBinding Gesture="Left" Command="{Binding PreviousStepCommand}" />
        <KeyBinding Gesture="Right" Command="{Binding NextStepCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style Selector="ComboBox.compact">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="StackPanel.windowControls Path">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Border.macTitleSpacer">
            <Setter Property="Height" Value="28" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window.macos Border.macTitleSpacer">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Window.macos StackPanel.windowControls">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.tabIndicator">
            <Setter Property="RenderTransform" Value="translateX(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tabIndicator.machine">
            <Setter Property="RenderTransform" Value="translateX(130px)" />
        </Style>
        <Style Selector="Border.tabIndicator.scan">
            <Setter Property="RenderTransform" Value="translateX(260px)" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="170,*">
        <Grid Grid.Column="0" RowDefinitions="Auto,40,*" Background="{StaticResource SidebarBrush}">
            <Border Classes="macTitleSpacer" Background="Transparent" PointerPressed="OnTitleBarPointerPressed" />

            <Border Grid.Row="1" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
                <Image Source="/Assets/Images/logo.png"
                       Width="140"
                       Margin="10,10,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
            </Border>

            <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
                <Panel>
                    <StackPanel IsVisible="{Binding !IsScanTab}">
                        <TextBlock Classes="heading" Text="File" />
                        <Button Theme="{StaticResource MenuItemButton}" Content="Salva cubo" Command="{Binding SaveCubeCommand}" />
                        <Button Theme="{StaticResource MenuItemButton}" Content="Carica cubo" Command="{Binding LoadCubeCommand}" />
                        <Button Theme="{StaticResource MenuItemButton}" Content="Svuota cubo" Command="{Binding ClearCubeCommand}" />

                        <TextBlock Classes="heading" Text="Seriale" Margin="10,10,0,0" />
                        <Grid ColumnDefinitions="*,Auto" Margin="10,0,6,0">
                            <ComboBox Classes="compact"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Nessuna porta"
                                      ItemsSource="{Binding SerialPorts}"
                                      SelectedItem="{Binding SelectedSerialPort}" />
                            <Button Grid.Column="1"
                                    Theme="{StaticResource IconButton}"
                                    Margin="4,0,0,0"
                                    ToolTip.Tip="Aggiorna porte"
                                    Command="{Binding RefreshSerialPortsCommand}">
                                <Path Data="M10,3 A5,5 0 1 0 11,8 M10,0 L10,3 L7,3"
                                      Stroke="{StaticResource InkBrush}"
                                      StrokeThickness="1.4"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsScanTab}">
                        <ComboBox Classes="compact"
                                  Margin="10,0"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Cameras}"
                                  SelectedItem="{Binding SelectedCamera}" />
                        <Border Margin="10,0"
                                Height="95"
                                BorderThickness="1"
                                BorderBrush="{StaticResource DividerBrush}" />

                        <Button Theme="{StaticResource MenuItemButton}" Content="Istantanea" />
                        <Button Theme="{StaticResource MenuItemButton}" Content="Auto griglia" />
                        <Button Theme="{StaticResource MenuItemButton}" Content="Stringi pinze" />

                        <Separator Margin="10,0" Background="{StaticResource DividerBrush}" />

                        <Button Theme="{StaticResource MenuItemButton}" Content="Scansiona" />
                        <Button Theme="{StaticResource MenuItemButton}" Content="Automatico" />

                        <Grid ColumnDefinitions="15,*" RowDefinitions="Auto,Auto,Auto" Margin="10,1,10,10" RowSpacing="1">
                            <TextBlock Grid.Row="0" Text="L" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Brightness}" Minimum="-100" Maximum="100" />
                            <TextBlock Grid.Row="1" Text="C" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Contrast}" Minimum="-100" Maximum="100" />
                            <TextBlock Grid.Row="2" Text="S" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Saturation}" Minimum="-100" Maximum="100" />
                        </Grid>
                    </StackPanel>
                </Panel>
            </ScrollViewer>
        </Grid>

        <ThemeVariantScope Grid.Column="1" RequestedThemeVariant="Dark">
            <Grid RowDefinitions="40,*">
                <Border Background="Transparent" PointerPressed="OnTitleBarPointerPressed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Theme="{StaticResource TabButton}" Content="Soluzione" Command="{Binding ShowSolveCommand}" />
                    <Button Theme="{StaticResource TabButton}" Content="Macchina" Command="{Binding ShowMachineCommand}" />
                    <Button Theme="{StaticResource TabButton}" Content="Scansione" Command="{Binding ShowScanCommand}" />
                </StackPanel>

                <Border Classes="tabIndicator"
                        Classes.scan="{Binding IsScanTab}"
                        Classes.machine="{Binding IsMachineTab}"
                        Width="130" Height="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource PaperBrush}" />

                <StackPanel Classes="windowControls"
                            Orientation="Horizontal"
                            Spacing="2"
                            Margin="0,10,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button Theme="{StaticResource WindowDotButton}" Background="{StaticResource CubeBlueBrush}" Click="OnTopmostClick">
                        <Path Data="M0,4 L3,1 L6,4" />
                    </Button>
                    <Button Theme="{StaticResource WindowDotButton}" Background="{StaticResource CubeGreenBrush}" Click="OnMinimizeClick">
                        <Path Data="M0,3 L6,3" />
                    </Button>
                    <Button Theme="{StaticResource WindowDotButton}" Background="{StaticResource CubeOrangeBrush}" Click="OnMaximizeClick">
                        <Path Data="M0,0 L6,0 L6,6 L0,6 Z" />
                    </Button>
                    <Button Theme="{StaticResource WindowDotButton}" Background="{StaticResource CubeRedBrush}" Click="OnCloseClick">
                        <Path Data="M0,0 L6,6 M6,0 L0,6" />
                    </Button>
                </StackPanel>

                <views:SolveView Grid.Row="1" IsVisible="{Binding IsSolveTab}" />
                <views:ScanView Grid.Row="1" IsVisible="{Binding IsScanTab}" />
                <Panel Grid.Row="1" IsVisible="{Binding IsMachineTab}">
                    <views:MachineView DataContext="{Binding Machine}" />
                </Panel>
            </Grid>
        </ThemeVariantScope>
    </Grid>
</Window>
