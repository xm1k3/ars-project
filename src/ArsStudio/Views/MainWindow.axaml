<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArsStudio.ViewModels"
        xmlns:m="using:ArsStudio.Core"
        xmlns:views="using:ArsStudio.Views"
        xmlns:conv="using:ArsStudio.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="450"
        x:Class="ArsStudio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Images/icon.png"
        Title="ARS Studio"
        Width="1100" Height="720"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource InkBrush}"
        FontSize="12"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="D0" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Empty}" />
        <KeyBinding Gesture="D1" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.White}" />
        <KeyBinding Gesture="D2" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Yellow}" />
        <KeyBinding Gesture="D3" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Orange}" />
        <KeyBinding Gesture="D4" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Red}" />
        <KeyBinding Gesture="D5" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Green}" />
        <KeyBinding Gesture="D6" Command="{Binding SelectColorCommand}" CommandParameter="{x:Static m:CubeColor.Blue}" />
        <KeyBinding Gesture="Left" Command="{Binding PreviousStepCommand}" />
        <KeyBinding Gesture="Right" Command="{Binding NextStepCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style Selector="ComboBox.compact">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#26000000" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.field">
            <Setter Property="Margin" Value="10,4,8,0" />
        </Style>
        <Style Selector="Grid.field > Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.fieldValue">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFeatures" Value="+lnum" />
            <Setter Property="Foreground" Value="#8C161B22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.adjust Slider">
            <Setter Property="Margin" Value="0,-8,0,-4" />
        </Style>
        <Style Selector="StackPanel.windowControls Path">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Border.macTitleSpacer">
            <Setter Property="Height" Value="28" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window.macos Border.macTitleSpacer">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Window.macos StackPanel.windowControls">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.tabIndicator">
            <Setter Property="RenderTransform" Value="translateX(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tabIndicator.machine">
            <Setter Property="RenderTransform" Value="translateX(130px)" />
        </Style>
        <Style Selector="Border.tabIndicator.scan">
            <Setter Property="RenderTransform" Value="translateX(260px)" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="170,*">
        <Grid Grid.Column="0" RowDefinitions="Auto,40,*" Background="{StaticResource SidebarBrush}">
            <Border Classes="macTitleSpacer" Background="Transparent" PointerPressed="OnTitleBarPointerPressed" />

            <Border Grid.Row="1" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
                <Image Source="/Assets/Images/logo.png"
                       Width="140"
                       Margin="10,10,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
            </Border>

            <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
                <Panel>
                    <StackPanel IsVisible="{Binding !IsScanTab}">
                        <TextBlock Classes="heading" Text="File" />
                        <Button Theme="{StaticResource MenuItemButton}" Content="Salva cubo" Command="{Binding SaveCubeCommand}" />
                        <Button Theme="{StaticResource MenuItemButton}" Content="Carica cubo" Command="{Binding LoadCubeCommand}" />
                        <Button Theme="{StaticResource MenuItemButton}" Content="Svuota cubo" Command="{Binding ClearCubeCommand}" />

                        <TextBlock Classes="heading" Text="Seriale" Margin="10,10,0,0" />
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <ComboBox Classes="compact"
                                      PlaceholderText="Nessuna porta"
                                      ItemsSource="{Binding SerialPorts}"
                                      SelectedItem="{Binding SelectedSerialPort}" />
                            <Button Grid.Column="1"
                                    Theme="{StaticResource IconButton}"
                                    ToolTip.Tip="Aggiorna porte"
                                    Command="{Binding RefreshSerialPortsCommand}">
                                <Path Data="M10,3 A5,5 0 1 0 11,8 M10,0 L10,3 L7,3"
                                      Stroke="{StaticResource InkBrush}"
                                      StrokeThickness="1.4"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsScanTab}">
                        <TextBlock Classes="heading" Text="Videocamera" />
                        <Grid Classes="field" ColumnDefinitions="*,Auto">
                            <ComboBox Classes="compact"
                                      PlaceholderText="Nessuna videocamera"
                                      ItemsSource="{Binding Scan.Cameras}"
                                      SelectedItem="{Binding Scan.SelectedCamera}" />
                            <Button Grid.Column="1"
                                    Theme="{StaticResource IconButton}"
                                    ToolTip.Tip="Aggiorna videocamere"
                                    Command="{Binding Scan.RefreshCamerasCommand}">
                                <Path Data="M10,3 A5,5 0 1 0 11,8 M10,0 L10,3 L7,3"
                                      Stroke="{StaticResource InkBrush}"
                                      StrokeThickness="1.4"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </Button>
                        </Grid>
                        <TextBlock Classes="heading" Text="Scansione" Margin="10,10,0,0" />
                        <Button Theme="{StaticResource MenuItemButton}"
                                Content="{Binding Scan.IsFrozen, Converter={x:Static views:ScanLabels.Freeze}}"
                                Command="{Binding Scan.ToggleFreezeCommand}" />
                        <Button Theme="{StaticResource MenuItemButton}"
                                Content="{Binding Scan.IsAutoCapture, Converter={x:Static views:ScanLabels.AutoCapture}}"
                                Command="{Binding Scan.ToggleAutoCaptureCommand}" />
                        <Button Theme="{StaticResource MenuItemButton}"
                                Content="{Binding Scan.IsTracking, Converter={x:Static views:ScanLabels.Tracking}}"
                                ToolTip.Tip="Automatico: il cubo viene cercato in tutta l'immagine. Griglia fissa: metti la faccia dentro i riquadri"
                                Command="{Binding Scan.ToggleTrackingCommand}" />
                        <Button Theme="{StaticResource MenuItemButton}" Content="Stringi pinze" Command="{Binding TightenGrippersCommand}" />

                        <Separator Margin="10,0" Background="{StaticResource DividerBrush}" />

                        <Button Theme="{StaticResource MenuItemButton}" Content="Scansiona" Command="{Binding Scan.CaptureCommand}" />
                        <Button Theme="{StaticResource MenuItemButton}" Content="Ricomincia" Command="{Binding Scan.RestartCommand}" />

                        <TextBlock Classes="heading" Text="Immagine" Margin="10,10,0,0" />
                        <StackPanel Classes="adjust" Margin="10,6,10,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="fieldLabel" Text="Zoom" />
                                <TextBlock Grid.Column="1" Classes="fieldValue" Text="{Binding Scan.Zoom, StringFormat={}{0:0.0}×}" />
                            </Grid>
                            <Slider Minimum="1" Maximum="4" Value="{Binding Scan.Zoom}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="fieldLabel" Text="Luminosità" />
                                <TextBlock Grid.Column="1" Classes="fieldValue" Text="{Binding Scan.Brightness, StringFormat={}{0:0}}" />
                            </Grid>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding Scan.Brightness}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="fieldLabel" Text="Contrasto" />
                                <TextBlock Grid.Column="1" Classes="fieldValue" Text="{Binding Scan.Contrast, StringFormat={}{0:0}}" />
                            </Grid>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding Scan.Contrast}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="fieldLabel" Text="Saturazione" />
                                <TextBlock Grid.Column="1" Classes="fieldValue" Text="{Binding Scan.Saturation, StringFormat={}{0:0}}" />
                            </Grid>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding Scan.Saturation}" />
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </ScrollViewer>
        </Grid>

        <ThemeVariantScope Grid.Column="1" RequestedThemeVariant="Dark">
            <Grid RowDefinitions="40,*">
                <Border Background="Transparent" PointerPressed="OnTitleBarPointerPressed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Theme="{StaticResource TabButton}" Content="Soluzione" Command="{Binding ShowSolveCommand}" />
                    <Button Theme="{StaticResource TabButton}" Content="Macchina" Command="{Binding ShowMachineCommand}" />
                    <Button Theme="{StaticResource TabButton}" Content="Scansione" Command="{Binding ShowScanCommand}" />
                </StackPanel>

                <Border Classes="tabIndicator"
                        Classes.scan="{Binding IsScanTab}"
                        Classes.machine="{Binding IsMachineTab}"
                        Width="130" Height="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource PaperBrush}" />

                <StackPanel Classes="windowControls"
                            Orientation="Horizontal"
                            Spacing="2"
                            Margin="0,10,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button Theme="{StaticResource WindowDotButton}" Background="{StaticResource CubeBlueBrush}" Click="OnTopmostClick">
                        <Path Data="M0,4 L3,1 L6,4" />
                    </Button>
                    <Button Theme="{StaticResource WindowDotButton}" Background="{StaticResource CubeGreenBrush}" Click="OnMinimizeClick">
                        <Path Data="M0,3 L6,3" />
                    </Button>
                    <Button Theme="{StaticResource WindowDotButton}" Background="{StaticResource CubeOrangeBrush}" Click="OnMaximizeClick">
                        <Path Data="M0,0 L6,0 L6,6 L0,6 Z" />
                    </Button>
                    <Button Theme="{StaticResource WindowDotButton}" Background="{StaticResource CubeRedBrush}" Click="OnCloseClick">
                        <Path Data="M0,0 L6,6 M6,0 L0,6" />
                    </Button>
                </StackPanel>

                <views:SolveView Grid.Row="1" IsVisible="{Binding IsSolveTab}" />
                <views:ScanView Grid.Row="1" IsVisible="{Binding IsScanTab}" />
                <Panel Grid.Row="1" IsVisible="{Binding IsMachineTab}">
                    <views:MachineView DataContext="{Binding Machine}" />
                </Panel>
            </Grid>
        </ThemeVariantScope>
    </Grid>
</Window>
