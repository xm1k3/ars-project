<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArsStudio.ViewModels"
             x:Class="ArsStudio.Views.ScanView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="10">
        <Slider Height="20" Value="{Binding Zoom}" Minimum="1" Maximum="4" />

        <Panel Grid.Row="1" Margin="0,10,0,0">
            <UniformGrid Rows="3" Columns="3"
                         Width="40" Height="40"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top">
                <Button Theme="{StaticResource ScanPickerButton}" />
                <Button Theme="{StaticResource ScanPickerButton}" />
                <Button Theme="{StaticResource ScanPickerButton}" />
                <Button Theme="{StaticResource ScanPickerButton}" />
                <Button Theme="{StaticResource ScanPickerButton}" />
                <Button Theme="{StaticResource ScanPickerButton}" />
                <Button Theme="{StaticResource ScanPickerButton}" />
                <Button Theme="{StaticResource ScanPickerButton}" />
                <Button Theme="{StaticResource ScanPickerButton}" />
            </UniformGrid>
        </Panel>
    </Grid>
</UserControl>
