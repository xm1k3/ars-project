<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArsStudio.ViewModels"
             xmlns:conv="using:ArsStudio.Converters"
             xmlns:controls="using:ArsStudio.Controls"
             xmlns:core="using:ArsStudio.Core"
             x:Class="ArsStudio.Views.SolveView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBlock.machineCode">
            <Setter Property="FontFamily" Value="Menlo, Consolas, DejaVu Sans Mono, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Path.icon">
            <Setter Property="Fill" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style Selector="Button.option">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.option /template/ Border">
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,300">
        <Grid RowDefinitions="*,Auto" Margin="16">
            <Panel>
                <controls:Cube3DView Frame="{Binding Frame}" IsVisible="{Binding Is3D}" />

                <Viewbox Margin="8,44,8,8"
                         MaxWidth="640"
                         Stretch="Uniform"
                         StretchDirection="Both"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="{Binding !Is3D}">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                        <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding Up}" />
                        <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding Left}" />
                        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Front}" />
                        <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding Right}" />
                        <ContentControl Grid.Row="1" Grid.Column="3" Content="{Binding Back}" />
                        <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding Down}" />
                    </Grid>
                </Viewbox>

                <Border Classes="segments" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Theme="{StaticResource SegmentButton}" Content="2D" Classes.active="{Binding !Is3D}" Command="{Binding Show2DCommand}" />
                        <Button Theme="{StaticResource SegmentButton}" Content="3D" Classes.active="{Binding Is3D}" Command="{Binding Show3DCommand}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Palette}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              ToolTip.Tip="Scegli un colore e clicca le caselle per comporre il cubo">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteItemViewModel">
                            <Button Theme="{StaticResource StickerButton}"
                                    Background="{Binding Color, Converter={x:Static conv:CubeColorToBrushConverter.Instance}}"
                                    Command="{Binding SelectCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>

            <Border Grid.Row="1" Padding="0,12,0,0" IsVisible="{Binding HasMoves}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="-6,0,0,0" VerticalAlignment="Center">
                            <Button Theme="{StaticResource TransportButton}" ToolTip.Tip="Mossa precedente" Command="{Binding PreviousStepCommand}">
                                <Path Classes="icon" Data="M8,0 L8,10 L0,5 Z" />
                            </Button>
                            <Button Theme="{StaticResource PlayButton}" Margin="2,0" Command="{Binding PlayCommand}" />
                            <Button Theme="{StaticResource TransportButton}" ToolTip.Tip="Mossa successiva" Command="{Binding NextStepCommand}">
                                <Path Classes="icon" Data="M0,0 L8,5 L0,10 Z" />
                            </Button>
                        </StackPanel>
                        <Slider Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="{Binding MoveCount}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding CurrentStep}" />
                        <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center" Text="{Binding StepText}" />
                    </Grid>

                    <Button Grid.Column="1"
                            Theme="{StaticResource SpeedButton}"
                            VerticalAlignment="Center"
                            Content="{Binding PlaybackSecondsText}"
                            ToolTip.Tip="Durata dell'animazione">
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuItem Header="0,5 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="0.5" />
                                <MenuItem Header="1 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="1" />
                                <MenuItem Header="1,5 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="1.5" />
                                <MenuItem Header="2 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="2" />
                                <MenuItem Header="3 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="3" />
                                <MenuItem Header="5 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="5" />
                                <MenuItem Header="10 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="10" />
                                <MenuItem Header="30 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="30" />
                                <MenuItem Header="60 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="60" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Classes="sidePanel">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                <StackPanel Margin="16,16,16,14" Spacing="10">
                    <TextBlock Classes="section" Text="Metodo" />
                    <Border Classes="segments">
                        <UniformGrid Columns="3">
                            <Button Theme="{StaticResource SegmentButton}"
                                    Classes="option"
                                    Classes.active="{Binding IsOptimized}"
                                    Content="Ottimizzato"
                                    Command="{Binding SetSolveMethodCommand}"
                                    CommandParameter="{x:Static core:SolveMethod.Optimized}" />
                            <Button Theme="{StaticResource SegmentButton}"
                                    Classes="option"
                                    Classes.active="{Binding IsKociemba}"
                                    Content="Kociemba"
                                    Command="{Binding SetSolveMethodCommand}"
                                    CommandParameter="{x:Static core:SolveMethod.Kociemba}" />
                            <Button Theme="{StaticResource SegmentButton}"
                                    Classes="option"
                                    Classes.active="{Binding IsLayers}"
                                    Content="A strati"
                                    Command="{Binding SetSolveMethodCommand}"
                                    CommandParameter="{x:Static core:SolveMethod.Layers}" />
                        </UniformGrid>
                    </Border>
                    <TextBlock Classes="caption" TextWrapping="Wrap" MinHeight="28" Text="{Binding SolveMethodHint}" />
                    <Button Theme="{StaticResource PrimaryButton}" Content="Risolvi" Command="{Binding SolveCommand}" />
                </StackPanel>

                <Border Grid.Row="1" Classes="rule" />

                <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10" Margin="16,14">
                    <Grid ColumnDefinitions="*,Auto" Height="26">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Classes="section" Text="Soluzione" VerticalAlignment="Center" />
                            <TextBlock Classes="caption" Text="{Binding SolutionCaption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="segments" VerticalAlignment="Center" IsVisible="{Binding HasMoves}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Theme="{StaticResource SegmentButton}"
                                        Width="50"
                                        Content="Mosse"
                                        Classes.active="{Binding ShowMoveList}"
                                        Command="{Binding ShowMovesCommand}" />
                                <Button Theme="{StaticResource SegmentButton}"
                                        Width="50"
                                        Content="Codice"
                                        ToolTip.Tip="Comandi inviati alla macchina"
                                        Classes.active="{Binding ShowMachineCode}"
                                        Command="{Binding ShowCodeCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Classes="caption"
                               TextWrapping="Wrap"
                               Text="Premi Risolvi per vedere qui le mosse"
                               IsVisible="{Binding !HasSolution}" />

                    <ScrollViewer Name="MovesScroll"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding ShowMoveList}">
                        <ItemsControl Name="Moves" ItemsSource="{Binding MoveChips}" Margin="-2,-2,8,-2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MoveChipViewModel">
                                    <Button Theme="{StaticResource MoveChipButton}"
                                            Classes="chip"
                                            Content="{Binding Text}"
                                            Classes.current="{Binding IsCurrent}"
                                            Classes.upcoming="{Binding IsUpcoming}"
                                            Command="{Binding SelectCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowMachineCode}">
                        <TextBlock Classes="machineCode" Margin="0,0,10,0" Text="{Binding MachineCode}" />
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="3" Classes="rule" />

                <StackPanel Grid.Row="4" Margin="16,14,16,16" Spacing="10">
                    <TextBlock Classes="section" Text="Macchina" />
                    <UniformGrid Columns="2" ColumnSpacing="8">
                        <Button Theme="{StaticResource SecondaryButton}" Content="Stringi pinze" Command="{Binding TightenGrippersCommand}" />
                        <Button Theme="{StaticResource SecondaryButton}" Content="Invia" Command="{Binding SendSolutionCommand}" />
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
