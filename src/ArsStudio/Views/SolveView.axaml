<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArsStudio.ViewModels"
             xmlns:conv="using:ArsStudio.Converters"
             xmlns:controls="using:ArsStudio.Controls"
             x:Class="ArsStudio.Views.SolveView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBlock.machineCode">
            <Setter Property="FontFamily" Value="Menlo, Consolas, DejaVu Sans Mono, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" MaxWidth="1100">
        <controls:Cube3DView Frame="{Binding Frame}" Margin="8,8,8,0" IsVisible="{Binding Is3D}" />

        <StackPanel Orientation="Horizontal"
                    Spacing="2"
                    Margin="0,10,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <Button Theme="{StaticResource SegmentButton}" Content="2D" Classes.active="{Binding !Is3D}" Command="{Binding Show2DCommand}" />
            <Button Theme="{StaticResource SegmentButton}" Content="3D" Classes.active="{Binding Is3D}" Command="{Binding Show3DCommand}" />
        </StackPanel>

        <Viewbox Margin="8,8,8,0"
                 MaxWidth="640"
                 Stretch="Uniform"
                 StretchDirection="Both"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsVisible="{Binding !Is3D}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding Up}" />
                <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding Left}" />
                <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Front}" />
                <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding Right}" />
                <ContentControl Grid.Row="1" Grid.Column="3" Content="{Binding Back}" />
                <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding Down}" />
            </Grid>
        </Viewbox>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="10,10,10,10">
            <StackPanel Spacing="10" VerticalAlignment="Bottom">
                <StackPanel Spacing="6" IsVisible="{Binding HasSolution}">
                    <TextBlock Classes="caption"
                               Text="{Binding SolutionCaption}"
                               Background="Transparent"
                               Cursor="Hand"
                               Tapped="OnSolutionTapped" />

                    <ItemsControl ItemsSource="{Binding MoveChips}" IsVisible="{Binding !ShowMachineCode}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="4" LineSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MoveChipViewModel">
                                <Button Theme="{StaticResource MoveChipButton}"
                                        Content="{Binding Text}"
                                        Classes.current="{Binding IsCurrent}"
                                        Classes.upcoming="{Binding IsUpcoming}"
                                        Command="{Binding SelectCommand}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="machineCode"
                               Text="{Binding MachineCode}"
                               Background="Transparent"
                               Cursor="Hand"
                               Tapped="OnSolutionTapped"
                               IsVisible="{Binding ShowMachineCode}" />

                    <Grid ColumnDefinitions="Auto,Auto,*" IsVisible="{Binding HasMoves}">
                        <Button Theme="{StaticResource PlayButton}" Command="{Binding PlayCommand}" />
                        <Button Grid.Column="1"
                                Theme="{StaticResource SpeedButton}"
                                Margin="8,0,0,0"
                                Content="{Binding PlaybackSecondsText}"
                                ToolTip.Tip="Durata dell'animazione">
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedLeft">
                                    <MenuItem Header="0,5 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="0.5" />
                                    <MenuItem Header="1 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="1" />
                                    <MenuItem Header="1,5 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="1.5" />
                                    <MenuItem Header="2 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="2" />
                                    <MenuItem Header="3 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="3" />
                                    <MenuItem Header="5 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="5" />
                                    <MenuItem Header="10 s" Command="{Binding SetPlaybackSecondsCommand}" CommandParameter="10" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Slider Grid.Column="2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="{Binding MoveCount}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding CurrentStep}" />
                    </Grid>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Palette}" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteItemViewModel">
                            <Button Theme="{StaticResource StickerButton}"
                                    Background="{Binding Color, Converter={x:Static conv:CubeColorToBrushConverter.Instance}}"
                                    Command="{Binding SelectCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Width="124"
                        Margin="16,0,0,0"
                        Spacing="6"
                        VerticalAlignment="Bottom">
                <Button Theme="{StaticResource PrimaryButton}" Content="Risolvi" Command="{Binding SolveCommand}" />
                <Button Theme="{StaticResource SecondaryButton}" Content="Stringi pinze" Command="{Binding TightenGrippersCommand}" />
                <Button Theme="{StaticResource SecondaryButton}" Content="Invia" Command="{Binding SendSolutionCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
