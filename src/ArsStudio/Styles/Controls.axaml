<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme x:Key="MenuItemButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <Border Name="Over" Background="{DynamicResource AccentGradientBrush}" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Over">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Over">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="PillButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="14" />
                    <Border Name="Over" Background="{DynamicResource AccentGradientBrush}" CornerRadius="14" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Over">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Over">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="StickerButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CubeEmptyBrush}" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <Border Name="Over" Background="Black" CornerRadius="4" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Over">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Over">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="TabButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="Width" Value="130" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <Border Name="Over" Background="White" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Over">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Over">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="WindowDotButton" TargetType="Button">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" />
                    <Border Name="Over" Background="Black" CornerRadius="8" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Over">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Over">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ScanPickerButton" TargetType="Button">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="BackEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource PaperBrush}" CornerRadius="5"
                        BorderThickness="2" BorderBrush="{DynamicResource CubeEmptyBrush}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.3)" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="scale(2.5)" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="MoveChipButton" TargetType="Button">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="Background" Value="{DynamicResource MoveChipBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFeatures" Value="+lnum" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                    <Border Name="Current" Background="{DynamicResource AccentGradientBrush}" CornerRadius="4" Opacity="0" />
                    <Border Name="Over" Background="White" CornerRadius="4" Opacity="0" />
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Over">
            <Setter Property="Opacity" Value="0.08" />
        </Style>
        <Style Selector="^.upcoming">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="^.current /template/ Border#Current">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="SegmentButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedPaperBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFeatures" Value="+lnum" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="11">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        </Style>
        <Style Selector="^.active">
            <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="PlayButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="13" />
                    <Border Name="Over" Background="{DynamicResource AccentGradientBrush}" CornerRadius="13" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <Path Data="M0,0 L8,5 L0,10 Z"
                          Fill="{DynamicResource InkBrush}"
                          Margin="2,0,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Over">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Over">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="SpeedButton" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0,8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource MutedPaperBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFeatures" Value="+lnum" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center" />
                        <Path Data="M0,0 L4,4 L8,0"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.4"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource MoveChipBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="16" />
                    <Border Name="Over" Background="White" CornerRadius="16" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Over">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Over">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource MoveChipBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16" />
                    <Border Name="Over" Background="White" CornerRadius="16" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Over">
            <Setter Property="Opacity" Value="0.08" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Over">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="11">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="TransportButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource MoveChipBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="RoundPrimaryButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="18" />
                    <Border Name="Over" Background="White" CornerRadius="18" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Over">
            <Setter Property="Opacity" Value="0.15" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Over">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
